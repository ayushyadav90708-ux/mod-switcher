{
  "schemaVersion": 1,
  "id": "pvp-ai",
  "version": "${version}",
  "name": "PvP AI Bot",
  "description": "Client-side AI-controlled combat assistant for Minecraft. Automatically fights a selected player using your character and inventory items. Designed for singleplayer and private practice environments.",
  "authors": [
    "PvP AI Contributors"
  ],
  "contact": {
    "homepage": "https://github.com/example/pvp-ai",
    "sources": "https://github.com/example/pvp-ai"
  },
  "license": "MIT",
  "icon": "assets/pvp-ai/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.pvpaibot.PvpAiClient"
    ]
  },
  "mixins": [
    "pvp-ai.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "another-mod": "*"
  }
}
